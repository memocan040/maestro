{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maestro Custom",
  "version": "0.35.1",
  "identifier": "com.memocan040.maestro.custom",
  "build": {
    "beforeDevCommand": "bun run dev --host",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run server:bundle && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Maestro Custom",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https: blob:; frame-src 'self' blob:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://localhost:* ws://127.0.0.1:* https: wss:; font-src 'self' data: https:",
      "dangerousDisableAssetCspModification": [
        "script-src",
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "resources": {
      "server-assets/": "server-assets/"
    }
  },
  "plugins": {}
}
